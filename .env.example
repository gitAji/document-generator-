# Copy this file to `.env` for local development with `netlify dev`.
# Never commit the real `.env` file — it's already covered by .gitignore.
#
# In production, set these as environment variables in the Netlify dashboard
# (Site settings > Environment variables) instead of committing them here.

# Apify API token (console.apify.com > Settings > Integrations)
APIFY_API_TOKEN=

# Anthropic API key (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
